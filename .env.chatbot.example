# Copy this file to .env.chatbot and provide the selected LLM settings.
# The real .env.chatbot file is ignored by Git.

CHATBOT_CHROMA_PATH=chroma_data
CHATBOT_COLLECTION_NAME=hrms_policies
CHATBOT_TOP_K=3
CHATBOT_MAX_HISTORY=10
CHATBOT_MAX_QUESTION_LENGTH=500
CHATBOT_LLM_PROVIDER=openai
CHATBOT_LLM_MODEL=
CHATBOT_LLM_API_KEY=
