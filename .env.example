DATABASE_URL=postgresql+psycopg://hrms_app:REPLACE_PASSWORD@localhost:5432/hrms
PII_KEY_ID=pii-v1
PII_KEY_BASE64=REPLACE_WITH_BASE64_ENCODED_32_BYTE_KEY
PII_PREVIOUS_KEYS={}
JWT_SECRET_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
# Local development: false. Production: true, with HTTPS enabled.
AUTH_COOKIE_SECURE=false
ENFORCE_HTTPS=false
HSTS_MAX_AGE_SECONDS=31536000
# Enable only behind a trusted reverse proxy that supplies X-Forwarded-Proto.
TRUST_PROXY_HEADERS=false
ALLOWED_FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=900
LOGIN_LOCKOUT_SECONDS=900
